generator client {
  provider = "prisma-client-js"
}

datasource db {
  // "postgresql" faz o Prisma gerar SQL no dialeto do Postgres
  // (SERIAL, TIMESTAMP, DOUBLE PRECISION...) em vez do dialeto do SQLite.
  provider = "postgresql"

  // url: usada pela API em produção, no dia a dia. Aponta para o endereço
  // POOLED do Neon (aquele com "-pooler" no host).
  url = env("DATABASE_URL")

  // directUrl: usada APENAS pelos comandos de migration. Aponta para o
  // endereço DIRETO do Neon (sem "-pooler"). Migrations não funcionam
  // através de um connection pooler.
  directUrl = env("DIRECT_URL")
}

model Biblioteca_K {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  senha    String
  telefone String

  criadoEm DateTime @default(now())

  emprestimos Emprestimo[]

  @@map("clientes")
}

model CategoriaObra {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String?

  obra Obra[]

  @@map("categorias_obras")
}

model Obra {
  id          Int @id @default(autoincrement())
  categoriaId Int

  anoPublicacao         Int?
  isbn                  String?       @unique
  categoria             CategoriaObra @relation(fields: [categoriaId], references: [id])
  statusDisponibilidade String        @default("Disponivel")

  emprestimos Emprestimo[]
  manutencoes Manutencao[]

  @@map("obras")
}

model Emprestimo {
  id        Int @id @default(autoincrement())
  clienteId Int
  obraId    Int

  cliente Biblioteca_K @relation(fields: [clienteId], references: [id])
  obra    Obra         @relation(fields: [obraId], references: [id])

  dataRetirada          DateTime  @default(now())
  dataPrevistaDevolucao DateTime
  dataDevolucaoReal     DateTime?

  valorTotal Float

  statusContrato String @default("Ativo")

  @@map("emprestimo")
}

model Manutencao {
  id     Int @id @default(autoincrement())
  obraId Int

  obra Obra @relation(fields: [obraId], references: [id])

  descricaoServico String
  dataManutencao   DateTime @default(now())
  valorCusto       Float

  @@map("manutencao")
}
