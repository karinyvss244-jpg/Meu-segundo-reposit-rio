generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Biblioteca_K {
  id       Int    @id @default(autoincrement())
  nome     String
  email    String @unique
  senha    String
  telefone String

  criadoEm DateTime @default(now())

  @@map("clientes")
}